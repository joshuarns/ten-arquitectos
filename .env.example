# WordPress that the dev/preview proxy forwards /wp-json to.
WP_PROXY_TARGET=https://cms.alejandroa184.sg-host.com

# REST API base used by the browser. Leave empty to use the /wp-json proxy.
# In production set the full URL (the CMS needs a valid SSL certificate):
# VITE_WP_API_URL=https://cms.alejandroa184.sg-host.com/wp-json
VITE_WP_API_URL=

# Category slug for News posts (default "news"). If the category does not
# exist or has no posts, the design's placeholder news is shown.
VITE_WP_NEWS_CATEGORY=news

# Category slug for Projects (default "projects"). If it does not exist,
# every post that is not News is a project.
VITE_WP_PROJECTS_CATEGORY=projects
