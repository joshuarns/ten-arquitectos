# WordPress that the dev/preview proxy forwards /wp-json to.
WP_PROXY_TARGET=https://cms.alejandroa184.sg-host.com

# REST API base used by the browser. Leave empty to use the /wp-json proxy.
# In production set the full URL (the CMS needs a valid SSL certificate):
# VITE_WP_API_URL=https://cms.alejandroa184.sg-host.com/wp-json
VITE_WP_API_URL=

# Category slug for News posts. Empty = all posts.
VITE_WP_NEWS_CATEGORY=
