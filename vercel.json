{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/wp-json/:rest*", "destination": "/api/cms?cmsPath=/wp-json/:rest*" },
    { "source": "/wp-content/:rest*", "destination": "/api/cms?cmsPath=/wp-content/:rest*" },
    { "source": "/((?!assets/|images/|api/).*)", "destination": "/index.html" }
  ]
}
